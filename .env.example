# =============================================================================
# LYS Terminal — Umgebungsvariablen (analog LYS Website)
# In Vercel: Project → Settings → Environment Variables (Production + Preview).
# Nach Änderungen: Redeploy. Geheime Keys niemals ins Git committen.
#
# Vercel-Projekt (wichtig):
# - Root Directory: leer (= Repo-Root), damit ./api/index.mjs und ./vercel.json greifen.
# - Build Command: npm run build:vercel (oder leer lassen, steht in vercel.json).
# - Output Directory: public (wie in vercel.json).
# =============================================================================

# --- Stripe (Server) ---
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
# Stripe Dashboard → Webhooks → Endpoint:
# https://lys-terminal-bestellseite.vercel.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# --- Öffentliche Web-Origin (Redirect success/cancel; zusätzlich sind *.vercel.app mit lys-terminal-bestellseite erlaubt) ---
# Exakter Name in Vercel: PUBLIC_WEB_ORIGIN (nicht PUBLIC_WEB_ORIG_ORIGIN).
# Eigene Domain oder Production-URL ohne trailing slash:
PUBLIC_WEB_ORIGIN=https://lys-terminal-bestellseite.vercel.app

# --- Supabase (Server: Service Role für pending_orders) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Supabase (Frontend Vite: Success-Seite / Polling, nur Anon) ---
VITE_SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY


# --- API (optional: nur wenn Frontend und API unterschiedliche Origins haben) ---
# VITE_API_BASE_URL=

# --- Personal/Staff: PIN für versteckten "Ausverkauft"-Modus im Terminal ---
# 4-stellig. Nur hier (Server-ENV), niemals im Frontend-Bundle.
STAFF_PIN=0000

# --- Fiskalisierung (fiskaly Cloud-TSE, KassenSichV) ---
# dashboard.fiskaly.com → API Keys. Test-Keys in Preview, Live-Keys in Production.
FISKALY_API_KEY=YOUR_FISKALY_API_KEY
FISKALY_API_SECRET=YOUR_FISKALY_API_SECRET
# SIGN DE Basis-URL — TEST und LIVE haben verschiedene Hosts (fiskaly-Referenz "Base URLs"):
#   TEST: https://kassensichv-middleware.fiskaly.com/api/v2
#   LIVE: https://kassensichv.fiskaly.com/api/v2   (erst beim Cutover umstellen!)
FISKALY_BASE_URL=https://kassensichv-middleware.fiskaly.com/api/v2
# DSFinV-K Basis-URL (Test): https://dsfinvk.fiskaly.com/api/v1
FISKALY_DSFINVK_BASE_URL=https://dsfinvk.fiskaly.com/api/v1
# Ausgabe von: node --env-file=.env scripts/fiskaly-setup.mjs
FISKALY_TSS_ID=
FISKALY_CLIENT_ID=
# Admin-PIN der TSS (vom Setup-Script gesetzt; für Admin-Operationen nötig)
FISKALY_ADMIN_PIN=

# --- Stripe Terminal (Kartenleser am Kiosk) ---
# Stripe Dashboard → Terminal → Readers (tmr_…). Preview: simulierter Reader.
STRIPE_TERMINAL_READER_ID=

# --- Vercel Cron (täglicher Kassenabschluss /api/fiscal/closing) ---
# Vercel schickt "Authorization: Bearer <CRON_SECRET>", wenn gesetzt.
CRON_SECRET=

# --- Lokal: Express ---
PORT=3000
